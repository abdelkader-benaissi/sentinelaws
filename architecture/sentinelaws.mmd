        ASG[RDS-backed Python API]
      end

      subgraph Data[Isolated database subnets]
        RDS[(Encrypted PostgreSQL RDS)]
      end
    end

    GD[GuardDuty]
    SH[Security Hub]
    CFG[AWS Config]
    EB[EventBridge]
    LQ[Quarantine Lambda]
    LW[WAF IP block Lambda]
    DDB[(Incident ledger)]
    DLQ[(Encrypted DLQs)]
    CT[CloudTrail]
    CW[CloudWatch Logs]
    S3[(Encrypted audit logs)]
  end

  U --> R53 --> WAF --> ALB --> ASG --> RDS
